# Redis — session metadata
REDIS_URL=redis://localhost:6379/0
SESSION_TIMEOUT=1800

# Hermes — host CLI already configured ~/.hermes?
# Then you do NOT need any *_API_KEY here. AIAgent loads ~/.hermes/.env and
# config.yaml the same way as the `hermes` CLI (see runtime/agent/agent_factory.py).
#
# Only set these when you want to override files (CI, K8s Secret, or quick tests):
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# HERMES_BASE_URL=

# Optional overrides (unset = use ~/.hermes model / provider):
# https://hermes-agent.nousresearch.com/docs/guides/python-library
# HERMES_MODEL=
HERMES_SKIP_MEMORY=true
HERMES_SKIP_CONTEXT_FILES=true
HERMES_MAX_ITERATIONS=90
# If you use HERMES_ENABLED_TOOLSETS (allowlist), include the gateway toolset so the model
# can call sandbox_shell / sandbox_python (default toolset name below):
# HERMES_ENABLED_TOOLSETS=web,gateway_sandbox
# HERMES_DISABLED_TOOLSETS=browser

# Session ↔ SandboxManager: acquire on first chat turn, release on DELETE /sessions/{id}
# SANDBOX_BIND_SESSION=1
# Route Hermes shell/Python off the host into the session-bound sandbox (disables Hermes terminal + code_execution)
# SANDBOX_ROUTE_HERMES_TOOLS=1
# SANDBOX_GATEWAY_TOOLSET=gateway_sandbox
# Local only: run sandbox_shell/sandbox_python on API host cwd instead of Docker (see runtime/hermes_gateway_sandbox_tools.py)
# VERIFY_GATEWAY_TOOLS_ON_HOST=1
# VERIFY_GATEWAY_TOOLS_CWD=/path/to/workspace   # default: uvicorn process cwd
# VERIFY_GATEWAY_TOOLS_TIMEOUT_SEC=120
# HERMES_PLATFORM=

# Optional: Hermes terminal.backend in ~/.hermes only applies when SANDBOX_ROUTE_HERMES_TOOLS=0
# or SandboxManager is disabled (no separate B-line routing).

# Remote sandbox manager (HTTP client to company control-plane). When set, embedded pool below is skipped.
# SANDBOX_MANAGER_BASE_URL=http://sandbox-manager:8080
# SANDBOX_MANAGER_TOKEN=

# AgentScope Runtime — optional warm sandbox pool (embedded; see README)
# AGENTSCOPE_SANDBOX_POOL_SIZE=2
# CONTAINER_DEPLOYMENT=docker
# AGENTSCOPE_SANDBOX_WATCHER_INTERVAL=15
# AGENTSCOPE_SANDBOX_MOUNT_DIR=sessions_mount_dir
# RUNTIME_SANDBOX_REGISTRY=   # optional: mirror registry if DockerHub is slow
